{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "HEVN",
  "description": "Documentation for HEVN products, including the CLI and REST API surfaces used by integrations.",
  "colors": {
    "primary": "#256FAD",
    "light": "#3C8DCE",
    "dark": "#1B527F"
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.png",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "defaults": "required"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "General",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "general/what-is-hevn",
              "general/architecture"
            ]
          },
          {
            "group": "Custody & wallets",
            "pages": [
              "general/privy-wallets",
              "general/smart-wallets",
              "general/shared-access"
            ]
          },
          {
            "group": "Money movement",
            "pages": [
              "general/deposits-and-payouts",
              "general/cross-chain"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "general/authentication",
              "general/trust-assumptions",
              "general/security-model"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "cli/overview",
              "cli/quickstart",
              "cli/agent-workflows",
              "cli/connect-agents",
              "cli/configuration"
            ]
          },
          {
            "group": "Core workflows",
            "pages": [
              "cli/commands/account",
              "cli/commands/contacts",
              "cli/commands/money-movement",
              "cli/commands/invoices",
              "cli/commands/contracts",
              "cli/commands/cards-banks"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "api-reference/app-api",
              "api-reference/mcp-api",
              "api-reference/public-api",
              "cli/development"
            ]
          }
        ]
      },
      {
        "tab": "REST API",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Generated API Reference",
            "openapi": "openapi.json"
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Book a call",
        "href": "https://calendly.com/hevn/hevn"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.gethevn.com"
    }
  },
  "redirects": [
    {
      "source": "/cli",
      "destination": "/cli/overview"
    },
    {
      "source": "/quickstart",
      "destination": "/cli/quickstart"
    },
    {
      "source": "/agent-workflows",
      "destination": "/cli/agent-workflows"
    },
    {
      "source": "/connect-agents",
      "destination": "/cli/connect-agents"
    },
    {
      "source": "/configuration",
      "destination": "/cli/configuration"
    },
    {
      "source": "/development",
      "destination": "/cli/development"
    },
    {
      "source": "/commands/account",
      "destination": "/cli/commands/account"
    },
    {
      "source": "/commands/contacts",
      "destination": "/cli/commands/contacts"
    },
    {
      "source": "/commands/money-movement",
      "destination": "/cli/commands/money-movement"
    },
    {
      "source": "/commands/invoices",
      "destination": "/cli/commands/invoices"
    },
    {
      "source": "/commands/contracts",
      "destination": "/cli/commands/contracts"
    },
    {
      "source": "/commands/cards-banks",
      "destination": "/cli/commands/cards-banks"
    }
  ]
}
