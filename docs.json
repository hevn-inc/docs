{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "HEVN",
  "description": "Documentation for HEVN products: the whitelabel REST API for integrators, the CLI for operators and agents, and how the platform works.",
  "colors": {
    "primary": "#256FAD",
    "light": "#3C8DCE",
    "dark": "#1B527F"
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.png",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "defaults": "required"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "General",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "general/what-is-hevn",
              "general/architecture"
            ]
          },
          {
            "group": "Custody & wallets",
            "pages": [
              "general/privy-wallets",
              "general/smart-wallets",
              "general/shared-access"
            ]
          },
          {
            "group": "Money movement",
            "pages": [
              "general/deposits-and-payouts",
              "general/cross-chain"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "general/authentication",
              "general/trust-assumptions",
              "general/security-model"
            ]
          }
        ]
      },
      {
        "tab": "Whitelabel",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "whitelabel/overview",
              "whitelabel/how-money-moves",
              "whitelabel/quickstart"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "whitelabel/accounts-and-custody",
              "whitelabel/developer-key",
              "whitelabel/sessions",
              "whitelabel/conventions",
              "whitelabel/signing"
            ]
          },
          {
            "group": "Onboard a client",
            "pages": [
              "whitelabel/clients",
              "whitelabel/onboarding",
              "whitelabel/bank-accounts"
            ]
          },
          {
            "group": "Move money",
            "pages": [
              "whitelabel/payins",
              "whitelabel/payouts",
              "whitelabel/balances-and-transactions"
            ]
          },
          {
            "group": "Escrow",
            "pages": [
              "whitelabel/escrow",
              "whitelabel/escrow-actions"
            ]
          },
          {
            "group": "Ship it",
            "pages": [
              "whitelabel/sandbox",
              "whitelabel/going-live"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "whitelabel/reference/rails",
              "whitelabel/reference/kyb-fields",
              "whitelabel/reference/errors",
              "whitelabel/reference/limits",
              "whitelabel/reference/client"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "cli/overview",
              "cli/quickstart",
              "cli/agent-workflows",
              "cli/connect-agents",
              "cli/configuration"
            ]
          },
          {
            "group": "Core workflows",
            "pages": [
              "cli/commands/account",
              "cli/commands/contacts",
              "cli/commands/money-movement",
              "cli/commands/invoices",
              "cli/commands/contracts",
              "cli/commands/cards-banks"
            ]
          }
        ]
      },
      {
        "tab": "REST API",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Authentication",
            "openapi": "openapi.json",
            "pages": [
              "POST /auth/challenge",
              "POST /auth/token",
              "POST /auth/refresh"
            ]
          },
          {
            "group": "Clients",
            "openapi": "openapi.json",
            "pages": [
              "POST /clients",
              "GET /clients",
              "GET /clients/{clientId}",
              "PATCH /clients/{clientId}"
            ]
          },
          {
            "group": "Verification",
            "openapi": "openapi.json",
            "pages": [
              "PUT /clients/{clientId}/kyb",
              "GET /clients/{clientId}/kyb",
              "POST /clients/{clientId}/kyb/submit",
              "POST /documents"
            ]
          },
          {
            "group": "Bank accounts",
            "openapi": "openapi.json",
            "pages": [
              "GET /banks",
              "POST /banks",
              "GET /banks/{rail}",
              "GET /banks/{rail}/requirements",
              "GET /banks/{rail}/rate"
            ]
          },
          {
            "group": "Money in",
            "openapi": "openapi.json",
            "pages": [
              "POST /payins",
              "POST /payins/{payinId}/instructions",
              "GET /payins/{payinId}"
            ]
          },
          {
            "group": "Money out",
            "openapi": "openapi.json",
            "pages": [
              "POST /payouts",
              "POST /payouts/{payoutId}/confirm",
              "GET /payouts/{payoutId}",
              "POST /payouts/preview"
            ]
          },
          {
            "group": "Recipients",
            "openapi": "openapi.json",
            "pages": [
              "POST /contacts",
              "GET /contacts",
              "GET /contacts/{contactId}",
              "PATCH /contacts/{contactId}",
              "DELETE /contacts/{contactId}",
              "GET /contacts/{contactId}/capabilities"
            ]
          },
          {
            "group": "Balances and transactions",
            "openapi": "openapi.json",
            "pages": [
              "GET /clients/{clientId}/balance",
              "GET /transactions",
              "GET /transactions/{transactionId}",
              "GET /transactions/summary",
              "GET /transactions/export"
            ]
          },
          {
            "group": "Escrow",
            "openapi": "openapi.json",
            "pages": [
              "POST /escrow",
              "GET /escrow",
              "GET /escrow/{escrowId}",
              "POST /escrow/{escrowId}/actions",
              "POST /escrow/{escrowId}/actions/{idempotencyKey}/confirm",
              "POST /escrow/{escrowId}/sync"
            ]
          },
          {
            "group": "Sandbox",
            "openapi": "openapi.json",
            "pages": [
              "GET /sandbox/treasury",
              "POST /sandbox/deposits",
              "POST /sandbox/payins/{payinId}/complete",
              "POST /sandbox/payouts/{payoutId}/status"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Book a call",
        "href": "https://calendly.com/hevn/hevn"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.gethevn.com"
    }
  },
  "redirects": [
    {
      "source": "/cli",
      "destination": "/cli/overview"
    },
    {
      "source": "/quickstart",
      "destination": "/cli/quickstart"
    },
    {
      "source": "/agent-workflows",
      "destination": "/cli/agent-workflows"
    },
    {
      "source": "/connect-agents",
      "destination": "/cli/connect-agents"
    },
    {
      "source": "/configuration",
      "destination": "/cli/configuration"
    },
    {
      "source": "/commands/account",
      "destination": "/cli/commands/account"
    },
    {
      "source": "/commands/contacts",
      "destination": "/cli/commands/contacts"
    },
    {
      "source": "/commands/money-movement",
      "destination": "/cli/commands/money-movement"
    },
    {
      "source": "/commands/invoices",
      "destination": "/cli/commands/invoices"
    },
    {
      "source": "/commands/contracts",
      "destination": "/cli/commands/contracts"
    },
    {
      "source": "/commands/cards-banks",
      "destination": "/cli/commands/cards-banks"
    },
    {
      "source": "/whitelabel/authentication",
      "destination": "/whitelabel/sessions"
    },
    {
      "source": "/whitelabel/workspaces",
      "destination": "/whitelabel/sessions"
    },
    {
      "source": "/whitelabel/client-profile",
      "destination": "/whitelabel/clients"
    },
    {
      "source": "/whitelabel/kyb",
      "destination": "/whitelabel/onboarding"
    },
    {
      "source": "/whitelabel/errors",
      "destination": "/whitelabel/reference/errors"
    },
    {
      "source": "/whitelabel",
      "destination": "/whitelabel/overview"
    },
    {
      "source": "/api-reference",
      "destination": "/api-reference/overview"
    }
  ]
}
